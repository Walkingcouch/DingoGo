# ── DingoGo API environment ──
NODE_ENV=production
PORT=4000
DATABASE_URL=postgres://dingogo:dingogo@localhost:5432/dingogo   # Supabase: use the "Session pooler" connection string
JWT_SECRET=change-me-to-a-long-random-string
OTP_DEV_MODE=false                       # true ONLY in development (returns codes, accepts 000000)
CORS_ORIGINS=https://dingogo.com.au,https://admin.dingogo.com.au,capacitor://localhost,http://localhost
PUBLIC_WEB_URL=https://dingogo.com.au    # used in share-trip and parcel tracking links

# Payments (Stripe, AUD). Leave blank to use the built-in mock provider.
STRIPE_SECRET_KEY=

# SMS (Twilio) for sign-in codes, parcel recipient PINs and SOS alerts to emergency contacts
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# Push notifications via Expo push service (apps register tokens at /me/push-token)
EXPO_PUSH_ENABLED=false

# Routing: self-hosted OSRM recommended (public demo server is not for production). Blank = distance estimate.
OSRM_URL=
# Or a free openrouteservice.org key (used when OSRM_URL is blank).
ORS_API_KEY=

# Dispatch tuning
OFFER_TIMEOUT_S=20
DISPATCH_MAX_ATTEMPTS=5
DISPATCH_RADIUS_KM=25
RANGE_DERATE=0.7          # heat + A/C derate on rated EV range
RANGE_RESERVE_KM=40
# Trip lifecycle (Round 3). All optional — defaults shown.
OFFER_GRACE_S=3               # last-second accept taps still count
DISPATCH_MAX_REOFFERS=2       # driver cancels before pickup → offered to the next driver at most this often
DRIVER_CANCEL_FLAG_COUNT=3    # cancellations after accepting in 7 days → compliance flag
DRIVER_SILENT_ALERT_MIN=4     # no signal from the driver of a live trip → ops alert
DRIVER_SILENT_REASSIGN_MIN=0  # auto-give an accepted trip to another driver after this long silent (0 = off)
DRIVER_STALE_OFFLINE_MIN=30   # online but no signal this long → set offline
SCHEDULED_MISSED_MIN=30       # bookings released this late are not sent to drivers
UPLOAD_DIR=./uploads

# Paid number-plate lookup (regcheck.org.uk CheckAustralia; each admin lookup costs a credit). Blank = off.
REGCHECK_USERNAME=

# Security (Round 2). All optional — defaults shown.
# Client IP for rate limits: on automatically on Vercel. Set true (or hop count / proxy IPs) behind your own reverse proxy.
TRUST_PROXY=
UPLOAD_LINK_TTL_S=3600        # signed links to driver documents / delivery photos
SHARE_LINK_HOURS=24           # share-trip links stop working this long after the trip ends
RATE_OTP_REQUEST_PER_IP=30    # per hour
RATE_OTP_VERIFY_FAIL_PER_IP=30
RATE_PUBLIC_FORM_PER_IP=10
RATE_ESTIMATE_PER_IP_10MIN=60
RATE_UPLOADS_PER_USER=30
RATE_PARTNER_CODE_FAILS=20
