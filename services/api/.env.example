# ── DingoGo API environment ──
NODE_ENV=production
PORT=4000
DATABASE_URL=postgres://dingogo:dingogo@localhost:5432/dingogo   # Supabase: use the "Session pooler" connection string
JWT_SECRET=change-me-to-a-long-random-string
OTP_DEV_MODE=false                       # true ONLY in development (returns codes, accepts 000000)
CORS_ORIGINS=https://dingogo.com.au,https://admin.dingogo.com.au,capacitor://localhost,http://localhost
PUBLIC_WEB_URL=https://dingogo.com.au    # used in share-trip and parcel tracking links

# Payments (Stripe, AUD). Leave blank to use the built-in mock provider (no network).
STRIPE_SECRET_KEY=                       # sk_live_… / sk_test_… (server only)
STRIPE_PUBLISHABLE_KEY=                  # pk_… sent to the rider app for the Stripe card form
STRIPE_WEBHOOK_SECRET=                   # whsec_… of the endpoint https://<api>/payments/stripe/webhook (Vercel: /api/payments/stripe/webhook)
# STRIPE_API_VERSION=2024-06-20          # pinned; change only after testing
# STRIPE_TIMEOUT_MS=15000
# STRIPE_WEBHOOK_TOLERANCE_S=300
# Without Stripe: who may "pay" by card with the mock provider. all | test (demo/test accounts only; others see "coming soon") | off.
# Default: all when OTP_DEV_MODE=true, otherwise test.
MOCK_CARDS=

# SMS (Twilio): sign-in codes, parcel PINs, SOS texts, trip texts for phone bookings, offers. Blank = texts written to the log.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=                             # +61… number (takes replies) or an alphanumeric sender ID such as DingoGo (one-way)
# TWILIO_MESSAGING_SERVICE_SID=          # MG… instead of TWILIO_FROM (number pool / sender ID set in Twilio)
# TWILIO_MARKETING_FROM=                 # +61… number for offers by text ("Reply STOP" must work); default TWILIO_FROM if it is a number
# Masked calls and texts between rider and driver. Point this number's Voice webhook at <api>/comms/twilio/voice and its
# Messaging webhook at <api>/comms/twilio/sms (POST). Also point every other DingoGo number's Messaging webhook at /comms/twilio/sms (STOP/START/HELP).
TWILIO_RELAY_NUMBER=
TWILIO_WEBHOOK_BASE_URL=                 # the API's public URL as Twilio calls it, for signatures, e.g. https://dingogo.com.au/api
# TWILIO_TIMEOUT_MS=8000

# Push notifications. In-app inbox and realtime always work.
FCM_SERVICE_ACCOUNT=                     # Firebase service-account JSON (or base64 of it): Android app push (FCM HTTP v1)
WEB_PUSH_VAPID_PUBLIC_KEY=               # Web Push for the installed web app; make a pair with: npm run vapid -w services/api
WEB_PUSH_VAPID_PRIVATE_KEY=
WEB_PUSH_SUBJECT=mailto:support@dingogo.com.au
EXPO_PUSH_ENABLED=false                  # legacy: only for Expo tokens

# Routing: self-hosted OSRM recommended (public demo server is not for production). Blank = distance estimate.
OSRM_URL=
# Or a free openrouteservice.org key (used when OSRM_URL is blank).
ORS_API_KEY=

# Dispatch tuning
OFFER_TIMEOUT_S=20
DISPATCH_MAX_ATTEMPTS=5
DISPATCH_RADIUS_KM=25
RANGE_DERATE=0.7          # heat + A/C derate on rated EV range
RANGE_RESERVE_KM=40
# Trip lifecycle (Round 3). All optional — defaults shown.
OFFER_GRACE_S=3               # last-second accept taps still count
DISPATCH_MAX_REOFFERS=2       # driver cancels before pickup → offered to the next driver at most this often
DRIVER_CANCEL_FLAG_COUNT=3    # cancellations after accepting in 7 days → compliance flag
DRIVER_SILENT_ALERT_MIN=4     # no signal from the driver of a live trip → ops alert
DRIVER_SILENT_REASSIGN_MIN=0  # auto-give an accepted trip to another driver after this long silent (0 = off)
DRIVER_STALE_OFFLINE_MIN=30   # online but no signal this long → set offline
SCHEDULED_MISSED_MIN=30       # bookings released this late are not sent to drivers
UPLOAD_DIR=./uploads

# Paid number-plate lookup (regcheck.org.uk CheckAustralia; each admin lookup costs a credit). Blank = off.
REGCHECK_USERNAME=

# Security (Round 2). All optional — defaults shown.
# Client IP for rate limits: on automatically on Vercel. Set true (or hop count / proxy IPs) behind your own reverse proxy.
TRUST_PROXY=
UPLOAD_LINK_TTL_S=3600        # signed links to driver documents / delivery photos
SHARE_LINK_HOURS=24           # share-trip links stop working this long after the trip ends
RATE_OTP_REQUEST_PER_IP=30    # per hour
RATE_OTP_VERIFY_FAIL_PER_IP=30
RATE_PUBLIC_FORM_PER_IP=10
RATE_ESTIMATE_PER_IP_10MIN=60
RATE_UPLOADS_PER_USER=30
RATE_PARTNER_CODE_FAILS=20
