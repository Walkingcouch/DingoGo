# ── DingoGo API environment ──
NODE_ENV=production
PORT=4000
DATABASE_URL=postgres://dingogo:dingogo@localhost:5432/dingogo   # Supabase: use the "Session pooler" connection string
JWT_SECRET=change-me-to-a-long-random-string
OTP_DEV_MODE=false                       # true ONLY in development (returns codes, accepts 000000)
CORS_ORIGINS=https://dingogo.com.au,https://admin.dingogo.com.au,capacitor://localhost,http://localhost
PUBLIC_WEB_URL=https://dingogo.com.au    # used in share-trip and parcel tracking links

# Payments (Stripe, AUD). Leave blank to use the built-in mock provider.
STRIPE_SECRET_KEY=

# SMS (Twilio) for sign-in codes, parcel recipient PINs and SOS alerts to emergency contacts
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# Push notifications via Expo push service (apps register tokens at /me/push-token)
EXPO_PUSH_ENABLED=false

# Routing: self-hosted OSRM recommended (public demo server is not for production). Blank = distance estimate.
OSRM_URL=
# Or a free openrouteservice.org key (used when OSRM_URL is blank).
ORS_API_KEY=

# Dispatch tuning
OFFER_TIMEOUT_S=20
DISPATCH_MAX_ATTEMPTS=5
DISPATCH_RADIUS_KM=25
RANGE_DERATE=0.7          # heat + A/C derate on rated EV range
RANGE_RESERVE_KM=40
UPLOAD_DIR=./uploads

# Paid number-plate lookup (regcheck.org.uk CheckAustralia; each admin lookup costs a credit). Blank = off.
REGCHECK_USERNAME=
