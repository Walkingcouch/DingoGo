# ── DingoGo API environment ──
NODE_ENV=production
PORT=4000
DATABASE_URL=postgres://dingogo:dingogo@localhost:5432/dingogo   # Supabase: transaction pooler (6543) on Vercel, or the session pooler

# Database operations (Round 10, all optional). See docs/OPERATIONS.md.
# MIGRATION_DATABASE_URL=                # owner connection for migrations/bootstrap/backups (Supabase session pooler); default DATABASE_URL
# DATABASE_URL_FALLBACKS=                # comma-separated alternate URLs (e.g. Supabase pooler hosts aws-0 / aws-1); the first that answers wins
# AUTO_MIGRATE=true: apply pending migrations at cold start (advisory lock; an empty database also gets base data + admin)
AUTO_MIGRATE=false
# AUTO_MIGRATE_WAIT_MS=10000             # wait this long for another instance that is migrating, then serve on
# AUTO_MIGRATE_STATEMENT_TIMEOUT_MS=20000
# MIGRATE_LOCK_TIMEOUT_MS=5000           # a migration that can't lock its tables this fast gives up instead of blocking live queries
# First admin for a new database (npm run db:bootstrap, or AUTO_MIGRATE on an empty database), e.g. 0412 345 678
BOOTSTRAP_ADMIN_PHONE=
# BOOTSTRAP_ADMIN_NAME=
# BOOTSTRAP_ADMIN_EMAIL=
# DB_API_ROLE=dingogo_api                # optional least-privilege role created by db:bootstrap (rows only, no schema changes)
# DB_API_ROLE_PASSWORD=
# DB_RLS=off                             # skip turning on Row Level Security (not recommended on Supabase)
# Send as X-Health-Token to read the full /health/deep report (uptime monitor)
HEALTH_TOKEN=
# DEMO_DATA=true                         # db:bootstrap / db:seed: load fictional demo data (never in production)
# ALLOW_DB_RESET=yes                     # let db:reset drop a non-local database (never in production)

# Performance (Round 18) — defaults suit Vercel + the Supabase transaction pooler
# DB_POOL_MAX=3                          # connections per instance (default 3 on serverless, 10 on a server)
# DB_IDLE_TIMEOUT_MS=5000                # close idle connections (default 5000 serverless, 10000 server)
# DB_QUERY_TIMEOUT_MS=25000              # the API stops waiting for a query after this long (0 = no limit)
# DB_STATEMENT_TIMEOUT_MS=15000          # Postgres cancels a statement in a transaction after this long (SET LOCAL; 0 = off)
# CONFIG_CACHE_TTL_MS=15000              # fare rules, zones, holidays, hot settings kept in memory per instance (0 = off)
# DISPATCH_TICK_EVERY_MS=3000            # serverless: one instance runs the dispatcher per this many ms (claimed in the database)

# Logs and error reporting
# LOG_LEVEL=info                         # JSON logs; default info in production, warn in development
# Optional: errors to Sentry (no personal data sent)
SENTRY_DSN=
# SENTRY_ENVIRONMENT=production
# GIT_SHA=                               # release name in logs/Sentry (Vercel sets VERCEL_GIT_COMMIT_SHA itself)
JWT_SECRET=change-me-to-a-long-random-string
OTP_DEV_MODE=false                       # true ONLY in development (returns codes, accepts 000000)
# OTP_DEMO_PREFIXES=                     # set (any value) to let the seeded demo numbers sign in with 000000 in production (demo mode)
# OTP_DEMO_NUMBERS=                      # the exact demo numbers that accept 000000 (default: the seeded demo accounts)
CORS_ORIGINS=https://dingogo.com.au,https://admin.dingogo.com.au,capacitor://localhost,http://localhost
PUBLIC_WEB_URL=https://dingogo.com.au    # used in share-trip and parcel tracking links

# Payments (Stripe, AUD). Leave blank to use the built-in mock provider (no network).
STRIPE_SECRET_KEY=                       # sk_live_… / sk_test_… (server only)
STRIPE_PUBLISHABLE_KEY=                  # pk_… sent to the rider app for the Stripe card form
STRIPE_WEBHOOK_SECRET=                   # whsec_… of the endpoint https://<api>/payments/stripe/webhook (Vercel: /api/payments/stripe/webhook)
# STRIPE_API_VERSION=2024-06-20          # pinned; change only after testing
# STRIPE_TIMEOUT_MS=15000
# STRIPE_WEBHOOK_TOLERANCE_S=300
# Without Stripe: who may "pay" by card with the mock provider. all | test (demo/test accounts only; others see "coming soon") | off.
# Default: all when OTP_DEV_MODE=true, otherwise test.
MOCK_CARDS=

# SMS (Twilio): sign-in codes, parcel PINs, SOS texts, trip texts for phone bookings, offers. Blank = texts written to the log.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=                             # +61… number (takes replies) or an alphanumeric sender ID such as DingoGo (one-way)
# TWILIO_MESSAGING_SERVICE_SID=          # MG… instead of TWILIO_FROM (number pool / sender ID set in Twilio)
# TWILIO_MARKETING_FROM=                 # +61… number for offers by text ("Reply STOP" must work); default TWILIO_FROM if it is a number
# Masked calls and texts between rider and driver. Point this number's Voice webhook at <api>/comms/twilio/voice and its
# Messaging webhook at <api>/comms/twilio/sms (POST). Also point every other DingoGo number's Messaging webhook at /comms/twilio/sms (STOP/START/HELP).
TWILIO_RELAY_NUMBER=
TWILIO_WEBHOOK_BASE_URL=                 # the API's public URL as Twilio calls it, for signatures, e.g. https://dingogo.com.au/api
# TWILIO_TIMEOUT_MS=8000

# Push notifications. In-app inbox and realtime always work.
FCM_SERVICE_ACCOUNT=                     # Firebase service-account JSON (or base64 of it): Android app push (FCM HTTP v1)
WEB_PUSH_VAPID_PUBLIC_KEY=               # Web Push for the installed web app; make a pair with: npm run vapid -w services/api
WEB_PUSH_VAPID_PRIVATE_KEY=
WEB_PUSH_SUBJECT=mailto:support@dingogo.com.au
EXPO_PUSH_ENABLED=false                  # legacy: only for Expo tokens

# Routing: self-hosted OSRM recommended (public demo server is not for production). Blank = distance estimate.
OSRM_URL=
# Or a free openrouteservice.org key (used when OSRM_URL is blank).
ORS_API_KEY=

# Dispatch tuning
OFFER_TIMEOUT_S=20
DISPATCH_MAX_ATTEMPTS=5
DISPATCH_SEARCH_WINDOW_MIN=5    # how long an on-demand trip searches for a driver
DISPATCH_TICK_MS=2000           # dispatcher timer on a server (serverless runs it on requests)
DISPATCH_GREEN_BONUS_M=1500     # electric/hybrid cars are treated as this much closer
SCHEDULED_LEAD_MIN=15           # booked trips are sent to drivers this long before pickup
DISPATCH_RADIUS_KM=25
RANGE_DERATE=0.7          # heat + A/C derate on rated EV range
RANGE_RESERVE_KM=40
# Trip lifecycle (Round 3). All optional — defaults shown.
OFFER_GRACE_S=3               # last-second accept taps still count
DISPATCH_MAX_REOFFERS=2       # driver cancels before pickup → offered to the next driver at most this often
DRIVER_CANCEL_FLAG_COUNT=3    # cancellations after accepting in 7 days → compliance flag
DRIVER_SILENT_ALERT_MIN=4     # no signal from the driver of a live trip → ops alert
DRIVER_SILENT_REASSIGN_MIN=0  # auto-give an accepted trip to another driver after this long silent (0 = off)
DRIVER_STALE_OFFLINE_MIN=30   # online but no signal this long → set offline
SCHEDULED_MISSED_MIN=30       # bookings released this late are not sent to drivers
UPLOAD_DIR=./uploads

# Paid number-plate lookup (regcheck.org.uk CheckAustralia; each admin lookup costs a credit). Blank = off.
REGCHECK_USERNAME=

# Security (Round 2). All optional — defaults shown.
# Client IP for rate limits: on automatically on Vercel. Set true (or hop count / proxy IPs) behind your own reverse proxy.
TRUST_PROXY=
UPLOAD_LINK_TTL_S=3600        # signed links to driver documents / delivery photos
SHARE_LINK_HOURS=24           # share-trip links stop working this long after the trip ends
RATE_OTP_REQUEST_PER_IP=30    # per hour
RATE_OTP_VERIFY_FAIL_PER_IP=30
RATE_PUBLIC_FORM_PER_IP=10
RATE_ESTIMATE_PER_IP_10MIN=60
RATE_UPLOADS_PER_USER=30
RATE_PARTNER_CODE_FAILS=20

# Safety and trust (Round 14). All optional. Rules (fatigue limits, check-ins, photo check, night window) are in admin → Safety → Policy.
FACE_MATCH_URL=               # face-match provider for driver photo checks: POST { selfie, reference } (base64) → { score }. Blank = DingoGo reviews photos.
FACE_MATCH_KEY=               # sent as a Bearer token
FACE_MATCH_TIMEOUT_MS=5000
REVERSE_GEOCODE_URL=          # Pelias/openrouteservice-style reverse geocoder for the emergency card's street address (ORS_API_KEY sent). Blank = nearest landmark + GPS.
SAFETY_TICK_S=20              # how often the dispatcher runs long-stop, check-in, fatigue and suspension checks
